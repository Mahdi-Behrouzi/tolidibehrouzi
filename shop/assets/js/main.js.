// JSONBin تنظیمات
const binUrl  = "https://api.jsonbin.io/v3/b/68e50c67d0ea881f40986859";
const apiKey  = "BAz3UXrj2Hs4CTSu9Sx.SORA0uPP1H62lvU/gZsySq7/iEzRRnAVe";


// راه‌اندازی Swiper بنر
new Swiper(".mySwiper", {
  loop: true,
  pagination: { el: ".swiper-pagination", clickable: true },
  autoplay: { delay: 3000 }
});

// بارگذاری محصولات از JSONBin
fetch(binUrl, {
  headers: { "X-Master-Key": apiKey }
})
  .then(r => r.json())
  .then(({ record }) => {
    const container = document.getElementById("productsContainer");
    record.forEach(p => {
      const col = document.createElement("div");
      col.className = "col-6 col-md-4 col-lg-3 mb-4";
      col.innerHTML = `
        <div class="product-card p-2">
          <img src="${p.image}" class="w-100 product-img" alt="${p.title}">
          <h6 class="mt-2">${p.title}</h6>
          <p class="text-danger fw-bold">${p.price} تومان</p>
          <button class="btn btn-sm btn-success w-100" onclick="addToCart(${p.id})">
            افزودن به سبد
          </button>
        </div>
      `;
      container.appendChild(col);
    });
  });

function addToCart(id) {
  const cart = JSON.parse(localStorage.getItem("cart"))||[];
  cart.push(id);
  localStorage.setItem("cart", JSON.stringify(cart));
  alert("به سبد اضافه شد!");
}
